# ─────────────────────────────────────────────────────────────────────────
# 环境变量模板（复制使用，不要直接改本文件生效）
#
# Vite 按 mode 加载：npm run dev → .env.development；npm run build → .env.production
# 同名变量以「.env.[mode]」覆盖「.env」；带 .local 后缀的文件优先级最高且已被
# .gitignore（*.local）忽略，适合放现场专有值。
#
# 变量清单（三个都由 src 读取，全部可缺省 —— 缺省时走代码里的兜底默认值）：
#   VITE_DATA_BASE_URL      雷达数据服务前缀，末尾必须带 /
#   VITE_TILE_SERVICE_BASE  天地图瓦片服务基地址，空串 = 公网 DataServer
#   VITE_TIANDITU_KEY       天地图 tk，与上一项成对
#
# 读取位置（改这里不会绕过兜底，只改 .env 即可切换环境）：
#   src/config/dataSource.ts     → DATA_BASE_URL
#   src/render/mapManager.ts     → TILE_SERVICE_BASE / TIANDITU_KEY
#   类型声明见 src/types/env.d.ts
# ─────────────────────────────────────────────────────────────────────────

# 开发：走 vite.config.ts 的 /radar-data 代理（9099 静态服务无 CORS 头）
# 生产：与 nginx 数据 location 前缀逐字一致，现网为 /data/radarData/
VITE_DATA_BASE_URL=/radar-data/

# 开发：留空走公网 DataServer（需要外网出口）
# 生产：内网 WMTS 节点基地址，末尾不带 /；客户端不可达时改走 nginx 同源反代路径
VITE_TILE_SERVICE_BASE=

# 开发：公网 DataServer 的 key
# 生产：内网 WMTS 节点的 tk（两者不通用，必须与 VITE_TILE_SERVICE_BASE 成对替换）
VITE_TIANDITU_KEY=
