# ─────────────────────────────────────────────────────────────────────────
# 生产环境配置（npm run build，Vite mode = production）
#
# 换服务器 / 改前缀只动本文件然后重新 npm run build，不需要改 src。
# ★ 变量在构建时内联，改完必须重新构建并覆盖站点目录（E:/ngi/dbzRadar/dist）★
# 不想起仓库里的文件时，可复制成 .env.production.local 做本机/现场覆盖
# （已被 .gitignore 的 *.local 规则忽略，不会被提交）。
# ─────────────────────────────────────────────────────────────────────────

# 雷达数据服务前缀：★ 必须与 nginx 的数据 location 前缀逐字一致，且末尾带 / ★
# 现网 nginx：location /data { alias E:/ngi/met; }，数据平铺在 met/radarData 下
#   → 前缀取 /data/radarData/（清单里的 binFile 是纯文件名，由该前缀拼接）
# 若 nginx 换成 location /radar-data/ { alias .../radarData/; }，这里同步改回 /radar-data/
# 前缀对不上时请求会落到 SPA 的 try_files 回落，返回 200 的 index.html，
# 表现为屏头「示意数据」假回波，而不是「该时次无数据」。
VITE_DATA_BASE_URL=/data/radarData/

# 行政底图（天地图）：内网 WMTS 节点基地址（末尾不带 /）。
# ★ 瓦片由浏览器直连，不是服务端代理 ★ 每台客户端都必须可达该地址；
#   不可达时改用 nginx 同源反代：location /tianditu/ { proxy_pass http://10.1.65.144:81/; }
#   然后把本值改成 /tianditu。站点上 https 时 http 瓦片会被按混合内容拦截，同理。
VITE_TILE_SERVICE_BASE=http://10.1.65.144:81

# 天地图 tk：与 VITE_TILE_SERVICE_BASE 成对配置（内网 WMTS 与公网 DataServer 的 tk 不通用）
VITE_TIANDITU_KEY=449b5f7b07a460aceb643861b3bb144c
