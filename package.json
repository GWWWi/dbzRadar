{
  "name": "radar2-2d-platform",
  "private": true,
  "version": "1.0.0",
  "description": "二维雷达显示平台（Vite + TS + Vue3 + QuickEarth）：产品列表 / 时间轴 / 多屏对比，主要显示雷达反射率",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs --port 5179 --strictPort",
    "build": "node scripts/build.cjs",
    "preview": "vite preview",
    "prepare:data": "node scripts/prepare-data.cjs"
  },
  "dependencies": {
    "@quickearth/core": "3.2.2",
    "@quickearth/leaflet": "3.2.2",
    "buffer": "^6.0.3",
    "compressjs": "1.0.3",
    "element-plus": "^2.14.5",
    "leaflet": "1.9.4",
    "seek-bzip": "^2.0.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@vitejs/plugin-vue": "5.0.4",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "1.8.27"
  }
}
